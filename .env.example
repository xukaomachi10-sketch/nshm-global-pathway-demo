# Optional. Used for absolute metadata URLs and canonical deployment context.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when this is omitted.
NEXT_PUBLIC_SITE_URL=

# Data pilot. Keep "mock" for the current Vercel demo.
# Allowed values: mock | supabase. Any missing/invalid value resolves to mock.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_REAL_STUDENT_IMPORT_ENABLED=false

# Public Supabase pilot connection. Either key variable may be used.
# Keep values blank in the committed example.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No database, authentication, storage, or API credentials are required in mock mode.
